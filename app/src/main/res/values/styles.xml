<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="SectionHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/fg_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="Check">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="SwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:progressTint">@color/accent</item>
        <item name="android:thumbTint">@color/accent</item>
    </style>
</resources>
